{
  "name": "testhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "desktop:dev": "pnpm --filter @testhub/desktop dev",
    "desktop:test": "pnpm --filter @testhub/desktop test",
    "desktop:package:mac": "pnpm --filter @testhub/desktop package:mac",
    "desktop:package:mac:preview": "pnpm --filter @testhub/desktop package:mac:preview",
    "desktop:package:win": "pnpm --filter @testhub/desktop package:win",
    "desktop:prepare:local": "node scripts/desktop/prepare-local-runtime.mjs",
    "desktop:verify:runtime": "node scripts/desktop/verify-local-runtime.mjs",
    "desktop:smoke:packaged": "node scripts/desktop/smoke-packaged.mjs"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.58.0",
    "echarts": "^6.0.0",
    "monaco-editor": "^0.52.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.39",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.0.15",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.3.0",
    "happy-dom": "^18.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.3"
  }
}
