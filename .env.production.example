# Copy to a deployment-only secret store or .env.production. Never commit real values.
TESTHUB_PLATFORM_IMAGE=registry.example.com/testhub/platform-api:0.1.0
TESTHUB_WEB_IMAGE=registry.example.com/testhub/web:0.1.0
TESTHUB_HTTP_PORT=8080
TESTHUB_CORS_ALLOWED_ORIGINS=https://testhub.example.com
TESTHUB_DB_PASSWORD=replace-with-a-long-random-secret
TESTHUB_DB_ROOT_PASSWORD=replace-with-a-different-long-random-secret
TESTHUB_REDIS_PASSWORD=replace-with-a-long-random-secret
TESTHUB_MINIO_ACCESS_KEY=replace-with-a-non-default-access-key
TESTHUB_MINIO_SECRET_KEY=replace-with-a-long-random-secret
# Base64 encoding of 16, 24, or 32 random bytes; generate and rotate outside the repository.
TESTHUB_ENCRYPTION_KEY=replace-with-base64-aes-key
# Non-secret identifier for the active data-encryption key. Use a new value for each staged rotation.
TESTHUB_ENCRYPTION_KEY_ID=primary-2026
# Semicolon-separated old key ring, for example: primary-2025:Base64OldKey. Leave empty outside a rotation window.
TESTHUB_PREVIOUS_ENCRYPTION_KEYS=
# Keep false except during a reviewed, single-writer re-encryption maintenance window.
TESTHUB_SECRET_REKEY_ENABLED=false
# Control-plane capacity baseline and server/pool limits. Tune only with measured evidence.
TESTHUB_CAPACITY_BASELINE_REQUEST_COUNT=60
TESTHUB_CAPACITY_BASELINE_CONCURRENCY=6
TESTHUB_CAPACITY_BASELINE_P95_LATENCY_MS=500
TESTHUB_CAPACITY_BASELINE_MAX_ERROR_PERCENT=1
TESTHUB_SERVER_MAX_THREADS=200
TESTHUB_SERVER_MIN_SPARE_THREADS=20
TESTHUB_SERVER_ACCEPT_COUNT=100
TESTHUB_SERVER_MAX_CONNECTIONS=8192
TESTHUB_SERVER_CONNECTION_TIMEOUT=10s
TESTHUB_DB_POOL_MAX_SIZE=20
TESTHUB_DB_POOL_MIN_IDLE=5
TESTHUB_DB_CONNECTION_TIMEOUT_MS=3000
TESTHUB_DB_VALIDATION_TIMEOUT_MS=1000
